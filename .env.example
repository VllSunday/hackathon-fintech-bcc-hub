# Скопируйте этот файл в .env и впишите ключ. Файл .env в git не попадает.
# Достаточно одного ключа: модель выберется автоматически.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini, бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------------------
# Всё ниже необязательно.

# Профиль запуска:
#   quick    — быстрый прогон, бюджет 60 запросов к модели
#   thorough — полный прогон, бюджет 400 запросов
# REQAUDIT_PROFILE=quick

# Модели по ролям в формате provider:model (provider: openai, gemini, anthropic, ollama).
# Если не заданы, берётся openai:gpt-5.5 при ключе OpenAI, gemini:gemini-3.5-flash-lite
# при ключе Gemini; при обоих ключах второй становится запасным.
# Через запятую — цепочка: следующая модель пробуется, если предыдущая недоступна.
# Модель, для которой нет ключа, пропускается.
#   JUDGE    — суждения о дефектах
#   ANALYST  — профиль документа и нарезка на требования; пусто = как у JUDGE
#   OPPONENT — попытка опровергнуть найденный дефект; пусто = как у JUDGE
#   VISION   — чтение сканов и картинок в PDF
# REQAUDIT_MODEL_JUDGE=openai:gpt-5.5
# REQAUDIT_MODEL_ANALYST=
# REQAUDIT_MODEL_OPPONENT=
# REQAUDIT_MODEL_VISION=

# Зрение модели для PDF и DOCX:
#   auto — сканы, страницы с испорченным текстовым слоем и картинки (по умолчанию для quick)
#   all  — ещё и сверка каждой страницы PDF с её изображением (по умолчанию для thorough)
#   off  — изображения модели не отправляются; непрочитанные страницы отмечаются в отчёте
# REQAUDIT_VISION=auto

# Читатель PDF: pymupdf (текстовый слой), docling (структура; нужна установка
# reqaudit[docling]), auto — Docling в профиле thorough, если он установлен
# REQAUDIT_PDF_READER=auto

# Не больше стольких запросов к модели за прогон
# REQAUDIT_MAX_LLM_CALLS=60

# Не чаще стольких запросов в минуту к одному провайдеру (для бесплатного Gemini
# поставьте значение из своего лимита: https://aistudio.google.com/rate-limit)
# REQAUDIT_RPM=5

# Где хранить кэш ответов модели
# REQAUDIT_CACHE_DIR=.cache/llm

# Ограничение размера входного файла, МБ
# REQAUDIT_MAX_INPUT_MB=50
