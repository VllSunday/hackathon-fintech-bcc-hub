# Скопируйте этот файл в .env и впишите ключи. Файл .env в git не попадает.
# На версии 0.1 модель ещё не вызывается, ключи понадобятся с подключением этапов s1–s8.

# Профиль запуска:
#   quick    — одна модель на бесплатном тарифе Gemini, чтобы прогон мог повторить любой
#   thorough — сильная модель на суждения, вторая модель оппонентом, зрительное чтение PDF
REQAUDIT_PROFILE=quick

# Google Gemini, бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI, нужен для профиля thorough
OPENAI_API_KEY=

# Модели по ролям в формате provider:model (provider: gemini, openai, anthropic, ollama).
# Конкретные модели выбираются сравнением на eval-стенде; значения ниже — черновые.
# Доступность и лимиты моделей Gemini проверьте у своего проекта: https://aistudio.google.com/rate-limit
REQAUDIT_MODEL_JUDGE=gemini:gemini-3.5-flash-lite
REQAUDIT_MODEL_OPPONENT=
REQAUDIT_MODEL_VISION=

# Ограничение размера входного файла, МБ
REQAUDIT_MAX_INPUT_MB=50
